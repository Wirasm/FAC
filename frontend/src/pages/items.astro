---
import SiteLayout from '../layouts/SiteLayout.astro';

// Fetch items from the API
const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000';
const response = await fetch(`${apiUrl}/api/items`);
const items = await response.json();

// Function to optimize Unsplash image URLs with size parameters
function optimizeImageUrl(url: string): string {
  if (!url) return 'https://via.placeholder.com/400x300';
  
  if (url.includes('unsplash.com')) {
    // Add size parameters to Unsplash URLs
    const separator = url.includes('?') ? '&' : '?';
    return `${url}${separator}w=400&h=300&fit=crop&auto=format&q=80`;
  }
  
  return url;
}
---

<SiteLayout title="Items | FAC Starter">
  <h1 class="text-4xl font-bold mb-8 text-center">Item Catalog</h1>
  
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 md:gap-6 mx-auto max-w-7xl">
    {items.map((item) => (
      <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow duration-300">
        <div class="item-image-container shimmer-loading">
          <img 
            src={optimizeImageUrl(item.image_url)} 
            alt={item.name}
            width="400"
            height="300"
            loading="lazy"
            class="item-image"
          />
        </div>
        <div class="p-4">
          <div class="flex justify-between items-start mb-2">
            <h2 class="text-xl font-semibold text-gray-800">{item.name}</h2>
            <span class="text-lg font-bold text-indigo-600">${item.price}</span>
          </div>
          <p class="text-gray-600 text-sm mb-3 line-clamp-2">{item.description}</p>
          <div class="flex justify-between items-center">
            <span class="text-sm px-2 py-1 rounded-full bg-gray-100 text-gray-800">
              {item.category}
            </span>
            <span class={`text-sm px-2 py-1 rounded-full ${item.in_stock ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}`}>
              {item.in_stock ? 'In Stock' : 'Out of Stock'}
            </span>
          </div>
        </div>
      </div>
    ))}
  </div>
  
  {items.length === 0 && (
    <div class="text-center py-12">
      <p class="text-lg text-gray-600">No items found. Please check back later.</p>
    </div>
  )}
</SiteLayout>

<style>
  /* Only keep our custom styles that aren't in Tailwind */
  .item-image-container {
    position: relative;
    height: 12rem;
    overflow: hidden;
    background-color: #f3f4f6;
  }
  
  .item-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  
  .item-image:hover {
    transform: scale(1.05);
  }
  
  /* Shimmer loading effect */
  .shimmer-loading {
    position: relative;
  }
  
  .shimmer-loading::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, #f0f0f0 25%, #f8f8f8 50%, #f0f0f0 75%);
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
    z-index: 1;
  }
  
  @keyframes shimmer {
    0% {
      background-position: -100% 0;
    }
    100% {
      background-position: 100% 0;
    }
  }
  
  /* Image loaded state */
  .item-image-loaded .shimmer-loading::before {
    display: none;
  }
  
  /* Use Tailwind's line-clamp plugin styling */
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<script>
  // More robust image loading script
  document.addEventListener('DOMContentLoaded', () => {
    const containers = document.querySelectorAll('.item-image-container');
    
    containers.forEach(container => {
      const img = container.querySelector('img');
      
      if (img) {
        // If image is already loaded
        if (img.complete) {
          container.classList.add('item-image-loaded');
        } else {
          // Add loaded class when image loads
          img.onload = () => {
            container.classList.add('item-image-loaded');
          };
          
          // Handle image load errors
          img.onerror = () => {
            // If image fails to load, still remove loading effect
            container.classList.add('item-image-loaded');
            // Optionally, show a fallback image
            img.src = 'https://via.placeholder.com/400x300?text=Image+Not+Found';
          };
        }
      }
    });
  });
</script>